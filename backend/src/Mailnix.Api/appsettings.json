{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Mailnix": {
    "Mode": "AllInOne",
    "Database": {
      "Provider": "Sqlite",
      "AutoMigrate": true
    },
    "Auth": {
      "AllowRegistration": false
    },
    "Bootstrap": {
      "AdminEmail": "",
      "AdminPassword": ""
    }
  }
}
