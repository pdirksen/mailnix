<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Mailnix.Api</RootNamespace>
    <UserSecretsId>mailnix-api</UserSecretsId>
    <!-- Icon of mailnix.exe (the standalone Windows app); generated by `npm run brand:icons` in frontend/ -->
    <ApplicationIcon>mailnix.ico</ApplicationIcon>
    <!-- Build-time OpenAPI document, consumed by the frontend's `npm run gen:api` -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name mailnix</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailnix.Infrastructure\Mailnix.Infrastructure.csproj" />
    <ProjectReference Include="..\Mailnix.Mail\Mailnix.Mail.csproj" />
    <ProjectReference Include="..\Mailnix.Core\Mailnix.Core.csproj" />
    <ProjectReference Include="..\Mailnix.Worker\Mailnix.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailnix.Integration.Tests" />
  </ItemGroup>

</Project>
