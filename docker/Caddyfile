# Reverse proxy for compose.saas.yml: HTTPS (automatic certificates for MAILNIX_DOMAIN) in front of the API replicas.
{$MAILNIX_DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy {
		# Every API replica of the compose service "api"; new replicas are picked up within 10 seconds.
		dynamic a {
			name api
			port 8080
			refresh 10s
		}
		# A browser stays on one replica, which the live connection (SignalR) needs.
		lb_policy cookie mailnix_lb
		health_uri /healthz
		health_interval 10s
	}
}
